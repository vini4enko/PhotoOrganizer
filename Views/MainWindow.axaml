
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ExifApp.ViewModels"
        xmlns:models="using:ExifApp.Models"
        xmlns:conv="using:ExifApp.Converters"
        xmlns:configuration="using:ExifApp.Configuration"
        x:Class="ExifApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PhotoOrganizer"
        Width="1280" Height="860"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">

        <!-- ========== Меню ========== -->
        <Menu Grid.Row="0" Background="#FAFAFA">

            <MenuItem Header="_Файл">
                <MenuItem Header="_Открыть…"
                          Click="OnLoadImageClick"
                          HotKey="Ctrl+O"
                          InputGesture="Ctrl+O"/>
                <MenuItem Header="Открыть _во внешней программе"
                          Command="{Binding OpenInExternalEditorCommand}"
                          HotKey="Ctrl+E"
                          InputGesture="Ctrl+E"/>
                <MenuItem Header="Конвертировать PNG → _JPEG"
                          Command="{Binding ConvertToJpegCommand}"/>
                <Separator/>
                <MenuItem Header="_Удалить файл"
                          Command="{Binding DeleteCurrentFileCommand}"
                          InputGesture="Delete"/>
                <Separator/>
                <MenuItem Header="В_ыход" Click="OnExitClick"/>
            </MenuItem>

            <MenuItem Header="_Правка">
                <MenuItem Header="_Редактировать EXIF…" Click="OnEditExifClick"/>
                <Separator/>
                <MenuItem Header="_Настройки…"
                          Click="OnOpenSettingsClick"
                          InputGesture="Ctrl+,"/>
            </MenuItem>

            <MenuItem Header="_Вид">
                <MenuItem Header="Сканировать подкаталоги"
                          ToggleType="CheckBox"
                          IsChecked="{Binding ScanSubdirectories, Mode=TwoWay}"/>
                <MenuItem Header="Фильтр по AllowedTags"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsFilterEnabled, Mode=TwoWay}"/>
                <Separator/>
                <MenuItem Header="_Предыдущий"
                          Command="{Binding PreviousCommand}"
                          InputGesture="Left"/>
                <MenuItem Header="_Следующий"
                          Command="{Binding NextCommand}"
                          InputGesture="Right"/>
            </MenuItem>

            <MenuItem Header="_Связь с БД">
                <MenuItem Header="Настройки подключения…"
                          Click="OnDbSettingsClick"/>
                <MenuItem Header="Проверить подключение"
                          Click="OnDbTestClick"/>
                <Separator/>
                <MenuItem Header="Синхронизировать каталог в БД"
                          IsEnabled="False"
                          ToolTip.Tip="Функционал в разработке"/>
                <MenuItem Header="Список фотографий из БД"
                          IsEnabled="False"
                          ToolTip.Tip="Функционал в разработке"/>
            </MenuItem>

            <MenuItem Header="_Справка">
                <MenuItem Header="_О программе" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <!-- ========== Панель быстрых действий ========== -->
        <Border Grid.Row="1"
                Background="#F0F0F0"
                Padding="8,6"
                BorderBrush="LightGray"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, *, Auto">

                <Button Grid.Column="0"
                        Content="📁"
                        Click="OnLoadImageClick"
                        Padding="10,6"
                        FontSize="14"
                        ToolTip.Tip="Открыть фото (Ctrl+O)"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="6,0,0,0">
                    <Button Content="⏮"
                            Command="{Binding PreviousCommand}"
                            Padding="10,6"
                            FontSize="14"
                            ToolTip.Tip="Предыдущий (←)"/>
                    <Button Content="⏭"
                            Command="{Binding NextCommand}"
                            Padding="10,6"
                            FontSize="14"
                            ToolTip.Tip="Следующий (→)"/>
                </StackPanel>

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding ExternalEditors}"
                          SelectedItem="{Binding SelectedExternalEditor}"
                          Width="220"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Внешняя программа для просмотра">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="configuration:ExternalEditor">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="3"
                        Content="🚀"
                        Command="{Binding OpenInExternalEditorCommand}"
                        Padding="10,6"
                        FontSize="14"
                        Margin="6,0,0,0"
                        ToolTip.Tip="Открыть во внешней программе (Ctrl+E)"/>

                <Button Grid.Column="4"
                        Content="🗑"
                        Command="{Binding DeleteCurrentFileCommand}"
                        Padding="10,6"
                        FontSize="14"
                        Margin="6,0,0,0"
                        ToolTip.Tip="Удалить текущий файл (Del)"/>

                <Border Grid.Column="6"
                        Padding="10,4"
                        Background="#E8E8E8"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding PositionText}"
                               FontWeight="SemiBold"
                               Foreground="#444"
                               MinWidth="60"
                               TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ========== Строка статуса ========== -->
        <Border Grid.Row="2"
                Background="#FAFAFA"
                Padding="12,6"
                BorderBrush="LightGray"
                BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#555"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ========== Основная область ========== -->
        <Grid Grid.Row="3" RowDefinitions="Auto, *">

            <Border Grid.Row="0"
                    Margin="10,10,10,0"
                    Padding="10,8"
                    Background="#F8F8F8"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0"
                               Text="Путь к файлу:"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <SelectableTextBlock Grid.Column="1"
                                         Text="{Binding SelectedFilePath}"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"
                                         TextWrapping="NoWrap"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*, 480">
                <Border Grid.Column="0"
                        Margin="10"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        Background="#FAFAFA">
                    <Image x:Name="PhotoImage"
                           Source="{Binding Photo}"
                           Stretch="Uniform"
                           Margin="5"
                           Cursor="Hand"
                           DoubleTapped="OnPhotoDoubleTapped"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           ToolTip.Tip="Двойной щелчок — открыть во внешней программе"/>
                </Border>

                <Border Grid.Column="1"
                        Margin="0,10,10,10"
                        BorderBrush="LightGray"
                        BorderThickness="1">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <TextBlock Grid.Row="0"
                                   Text="EXIF Метаданные"
                                   FontWeight="Bold"
                                   Padding="10,8"
                                   Background="#F0F0F0"/>

                        <Border Grid.Row="1"
                                Padding="10,8"
                                Background="#FBFBFB"
                                BorderBrush="LightGray"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Фильтр:"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="Gray"
                                               Text="{Binding IsFilterEnabled, Converter={x:Static conv:BoolToFilterTextConverter.Instance}}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding IsFilterEnabled}"
                                              OnContent="ВКЛ"
                                              OffContent="ВЫКЛ"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="2" ItemsSource="{Binding MetadataList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ExifItem">
                                    <Grid ColumnDefinitions="120, 150, *" Margin="0,2">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Directory}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0066CC"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,5,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TagName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,5,0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========== Лента миниатюр ========== -->
        <Border Grid.Row="4"
                Background="#F0F0F0"
                BorderBrush="LightGray"
                BorderThickness="0,1,0,0"
                Height="130">
            <ListBox x:Name="ThumbnailsListBox"
                     ItemsSource="{Binding PhotoList}"
                     SelectedIndex="{Binding CurrentIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="6"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="Margin" Value="1"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PhotoEntry">
                        <StackPanel Width="112" ToolTip.Tip="{Binding FilePath}">
                            <Border BorderBrush="#DDD" BorderThickness="1" Background="White">
                                <Image Source="{Binding Thumbnail}"
                                       Width="100" Height="72" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{Binding FileName}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>