<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ExifApp.ViewModels"
        x:Class="ExifApp.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Редактор настроек (appsettings.json)"
        Width="820" Height="620"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="10">

        <!-- Подсказка -->
        <TextBlock Grid.Row="0"
                   Text="Редактирование appsettings.json. После сохранения настройки применяются автоматически."
                   Foreground="#666"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- Редактор JSON -->
        <TextBox Grid.Row="1"
                 Text="{Binding JsonContent}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Consolas, Menlo, monospace"
                 FontSize="13"
                 TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 HorizontalContentAlignment="Left"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- Сообщение об ошибке -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="#C62828"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   MinHeight="20"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="↻ Перечитать"
                    Command="{Binding ReloadCommand}"
                    Padding="12,6"/>
            <Button Content="💾 Сохранить"
                    Command="{Binding SaveCommand}"
                    Padding="12,6"
                    FontWeight="SemiBold"/>
            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>